        bigint id PK
        bigint subject_id FK
        varchar code UK
        varchar description
        varchar education_level
    }

    PROGRAMS {
        bigint id PK
        bigint organizer_id FK
        varchar code UK
        varchar name
        varchar education_level
        decimal base_cost_per_student
        smallint duration_days
        smallint capacity
        enum status
        text description
    }

    PROGRAM_REQUIREMENTS {
        bigint program_id FK
        bigint requirement_id FK
        text mapping_note
    }

    PROGRAM_SCHEDULES {
        bigint id PK
        bigint program_id FK
        date trip_date
        time start_time
        time end_time
        smallint capacity
        decimal cost_override
        enum status
    }

    PROGRAM_SUBJECTS {
        bigint program_id FK
        bigint subject_id FK
        varchar learning_role
    }

    PLACES {
        bigint id PK
        varchar name
        varchar province
        decimal lat
        decimal lng
        varchar best_season
        smallint visit_minutes
        text description
        varchar source_note
    }

    PARENTS {
        bigint id PK
        bigint user_id FK
        varchar full_name
        varchar phone
        varchar relationship_note
        timestamp created_at
    }

    STUDENTS {
        bigint id PK
        bigint class_id FK
        varchar student_code UK
        varchar full_name
        smallint birth_year
        text medical_info_encrypted
        timestamp created_at
    }

    PARENT_STUDENT {
        bigint parent_id FK
        bigint student_id FK
        enum relationship_type
        boolean is_primary
    }

    PARENT_NOTIFICATIONS {
        bigint id PK
        bigint parent_id FK
        bigint student_id FK
        bigint schedule_id FK
        enum notification_type
        varchar title
        text message
        timestamp sent_at
        timestamp read_at
    }

    CLASS_REGISTRATIONS {
        bigint id PK
        bigint class_id FK
        bigint schedule_id FK
        enum status
        timestamp registered_at
    }

    LEARNING_EVALUATIONS {
        bigint id PK
        bigint student_id FK
        bigint schedule_id FK
        bigint teacher_id FK
        decimal learning_score
        text learning_outcome
        timestamp evaluated_at
    }

    TEACHER_ASSIGNMENTS {
        bigint id PK
        bigint schedule_id FK
        bigint teacher_id FK
        enum assignment_role
        timestamp assigned_at
    }

    SAFETY_PROFILES {
        bigint id PK
        bigint schedule_id FK
        enum risk_level
        text first_aid_plan
        text emergency_plan
        varchar weather_threshold
        text emergency_contact
        timestamp reviewed_at
    }

    SCHEDULE_STOPS {
        bigint id PK
        bigint schedule_id FK
        bigint place_id FK
        tinyint seq_no
        text activity
        smallint duration_minutes
    }

    ATTENDANCE_POINTS {
        bigint id PK
        bigint schedule_id FK
        tinyint seq_no
        varchar point_name
        timestamp checkpoint_at
    }

    PARENT_CONSENTS {
        bigint id PK
        bigint registration_id FK
        bigint parent_id FK
        bigint student_id FK
        enum consent_status
        timestamp consented_at
        text note
    }

    ATTENDANCE_RECORDS {
        bigint id PK
        bigint attendance_point_id FK
        bigint student_id FK
        enum attendance_status
        bigint recorded_by FK
        timestamp recorded_at
    }

