erDiagram
    USERS {
        bigint id PK
        varchar email UK
        varchar password_hash
        enum role
        enum status
        datetime last_login_at
        timestamp created_at
    }

    AUDIT_LOGS {
        bigint id PK
        bigint actor_id FK
        varchar action
        varchar entity
        bigint entity_id
        text before_json
        text after_json
        varchar ip_address
        timestamp created_at
    }

    SCHOOLS {
        bigint id PK
        bigint user_id FK
        varchar name
        varchar province
        varchar address
        enum status
        timestamp created_at
    }

    ORGANIZERS {
        bigint id PK
        bigint user_id FK
        varchar name
        varchar license_code
        varchar province
        enum status
        timestamp created_at
    }

    SUBJECTS {
        bigint id PK
        varchar code UK
        varchar name
        varchar education_level
    }

    SCHOOL_CLASSES {
        bigint id PK
        bigint school_id FK
        varchar class_name
        varchar grade_level
        varchar academic_year
        enum status
        timestamp created_at
    }

    TEACHERS {
        bigint id PK
