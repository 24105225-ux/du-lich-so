<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Relations\BelongsTo;
use Illuminate\Database\Eloquent\Relations\HasMany;
use Illuminate\Database\Eloquent\Relations\HasOne;

class ProgramSchedule extends Model
{
    protected $fillable = [
        'program_id',
        'trip_date',
        'start_time',
        'end_time',
        'capacity',
        'cost_override',
        'status',
    ];

    protected $casts = [
        'trip_date' => 'date',
        'cost_override' => 'decimal:2',
        'capacity' => 'integer',
    ];

    public function program(): BelongsTo
    {
        return $this->belongsTo(Program::class);
    }

    public function stops(): HasMany
    {
        return $this->hasMany(ScheduleStop::class)
            ->orderBy('day_no')
            ->orderBy('seq_no');
    }

    public function registrations(): HasMany
    {
        return $this->hasMany(ClassRegistration::class);
    }

    public function safetyProfile(): HasOne
    {
        return $this->hasOne(SafetyProfile::class);
    }
}
