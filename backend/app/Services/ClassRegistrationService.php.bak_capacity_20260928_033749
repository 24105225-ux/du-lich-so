<?php

namespace App\Services;

use App\Models\ClassRegistration;
use App\Models\ProgramSchedule;
use App\Models\SchoolClass;
use Illuminate\Support\Facades\DB;
use RuntimeException;

class ClassRegistrationService
{
    public function formData(): array
    {
        $classes = SchoolClass::query()
            ->with('school:id,name')
            ->withCount('students')
            ->orderBy('school_id')
            ->orderBy('class_name')
            ->get();

        $schedules = ProgramSchedule::query()
            ->with('program:id,name')
            ->where('status', 'open')
            ->whereDate('trip_date', '>=', today())
            ->orderBy('trip_date')
            ->orderBy('start_time')
            ->get();

        return [
            'classes' => $classes,
            'schedules' => $schedules,
        ];
    }

    public function register(
        int $classId,
        int $scheduleId,
        int $studentCount
    ): ClassRegistration {
        return DB::transaction(
            function () use (
                $classId,
                $scheduleId,
                $studentCount
            ) {
                /*
                 * Khoa lich de tranh 2 nguoi dang ky
                 * dong thoi lam vuot capacity.
                 */
                $schedule = ProgramSchedule::query()
                    ->whereKey($scheduleId)
                    ->lockForUpdate()
                    ->firstOrFail();

                /*
                 * Lay si so thuc te cua lop:
                 * COUNT(students.id)
                 */
                $schoolClass = SchoolClass::query()
                    ->withCount('students')
                    ->whereKey($classId)
                    ->firstOrFail();

                if ($schedule->status !== 'open') {
                    throw new RuntimeException(
                        'Chuong trinh hien khong mo dang ky.'
                    );
                }

                /*
                 * Khong cho so hoc sinh <= 0.
                 */
                if ($studentCount < 1) {
                    throw new RuntimeException(
                        'So hoc sinh dang ky phai tu 1 tro len.'
                    );
                }

                /*
                 * Si so thuc te cua lop.
                 */
                $classStudentCount =
                    (int) $schoolClass->students_count;

                /*
                 * SO HOC SINH DANG KY KHONG DUOC
                 * LON HON SI SO LOP.
                 */
                if ($studentCount > $classStudentCount) {
                    throw new RuntimeException(
                        "So hoc sinh dang ky khong duoc lon hon si so lop ({$classStudentCount} hoc sinh)."
                    );
                }

                /*
                 * Mot lop khong duoc dang ky cung
                 * mot lich nhieu lan.
                 */
                $duplicate = ClassRegistration::query()
                    ->where(
                        'class_id',
                        $schoolClass->id
                    )
                    ->where(
                        'schedule_id',
                        $schedule->id
                    )
                    ->whereIn(
                        'status',
                        [
                            'pending',
                            'approved'
                        ]
                    )
                    ->exists();

                if ($duplicate) {
                    throw new RuntimeException(
                        'Lop nay da dang ky chuong trinh nay.'
                    );
                }

                /*
                 * Tong so hoc sinh da chiem cho trong lich.
                 */
                $usedSeats = ClassRegistration::query()
                    ->where(
                        'schedule_id',
                        $schedule->id
                    )
                    ->whereIn(
                        'status',
                        [
                            'pending',
                            'approved'
                        ]
                    )
                    ->sum('student_count');

                /*
                 * So cho con lai.
                 */
                $remainingSeats =
                    (int) $schedule->capacity
                    - (int) $usedSeats;

                /*
                 * Khong cho vuot capacity cua lich.
                 */
                if ($studentCount > $remainingSeats) {
                    throw new RuntimeException(
                        "Chi con {$remainingSeats} cho trong."
                    );
                }

                /*
                 * Luu dang ky.
                 *
                 * DB dung schedule_id,
                 * khong phai program_schedule_id.
                 */
                return ClassRegistration::create([
                    'class_id' => $schoolClass->id,
                    'schedule_id' => $schedule->id,
                    'student_count' => $studentCount,
                    'status' => 'pending',
                ]);
            }
        );
    }
}
